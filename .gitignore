# User-provided / copyrighted inputs
roms/
*.gba
*.GBA
gbarecomp/bios/*.bin

# Generated (ROM/BIOS-derived) code
generated/*.c
generated/*.cpp
generated/*.h
generated/*.json
generated_bios/

# Build output and local tools
build/
build-*/
toolchain/

# Runtime artifacts
saves/
*.sav
*.srm
recomp_cache*/
recomp_coverage*.json
recomp_master_misses*.toml.frag
recomp_seed_proposals.toml
*.log
*.bmp
*.ppm
hang_trace.csv
__pycache__/

# Raw readelf dumps (regenerated by tools/import_symbols.sh)
symbols/bn6f_readelf_*.txt

# C port: build output and (for now) regenerable lifter output
cport/build*/
cport/build.log
cport/src/lifted/
cport/include/lifted.h
cport/include/bn6f_syms.h
cport/include/bn6f_equates.h
build-tools/
profile.txt
cport/include/difftest_pairs.h
cport/include/lifted_originals.h
cport/include/gen/
# coverage profiles are regenerable; the observed call edges (small, stamped) are kept
tools/traces/coverage/*
!tools/traces/coverage/*.edges

# recordings keep their starting and ending saves
!tools/traces/*.sav
tools/convert/log/
tools/convert/accepted/
tools/convert/rejected/
tools/convert/usage.jsonl
tools/convert/quota.jsonl
symbols/symdb.sqlite

# Claude Code session lock
.claude/scheduled_tasks.lock

# The old PC port (gbarecomp framework, recomp-ui, their output) left the repo on 2026-10-10;
# local copies stay (gbarecomp/bios holds the BIOS the test tools use until it moves to roms/).
/gbarecomp/
/recomp-ui/
/generated/
/src/

# vidsync's working directory (tools/paths.env VIDSYNC): video data, runs, the exported recording; never commit.
# build-*/ covers the directory; this line covers a worktree's link to the main checkout's.
/build-vidsync
