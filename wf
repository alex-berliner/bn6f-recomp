#!/usr/bin/env bash
# The workflows' command line, from anywhere: ./wf status, ./wf farm ..., ./wf --help.
# It runs `python -m wf` with tools/wf/.venv's Python, so nothing needs activating, and it stays
# where it was started, so paths in the arguments mean what they say there.
root=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
python="$root/tools/wf/.venv/bin/python"
if [ ! -x "$python" ]; then
    echo "wf: no $python; make it with: (cd $root/tools/wf && uv sync)" >&2
    exit 1
fi
export PYTHONPATH="$root/tools/wf${PYTHONPATH:+:$PYTHONPATH}"
exec "$python" -P -m wf "$@"   # -P: only tools/wf on the path, not the directory it was started in
